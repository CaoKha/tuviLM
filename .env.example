# Copy to .env (git ignores it). The web app and `cargo tuvi` read it.

# --- LLM: set ONE key. When both are set, OpenCode Go wins. ---------------

# OpenCode Go (https://opencode.ai/docs/go). OPENCODE_GO_API_KEY also works.
OPENCODE_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: force a provider: opencode-go | openrouter
# TUVI_LLM_PROVIDER=

# Optional: model id. Defaults: glm-5.3 (OpenCode Go), qwen/qwen3.7-max (OpenRouter).
# On OpenCode Go, pick a model whose format is "chat-completions":
#   curl -s https://opencode.ai/zen/go/v1/models
# TUVI_LLM_MODEL=

# Optional: API base URL, for a proxy or a self-hosted gateway.
# TUVI_LLM_BASE_URL=
